# Supabase (create a project at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only — never expose to the browser. Optional: used for account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
# Gemini (server only)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Separate image-generation model (do NOT point this at the chat model —
# gemini-2.0-flash returns text only, so image generation can never work
# with it). Default gemini-2.5-flash-image ("Nano Banana") returns image
# data via :generateContent with responseModalities ["TEXT","IMAGE"].
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Public URL of this app (used for auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional email provider for report delivery (leave blank = delivery unavailable)
# Set EMAIL_PROVIDER=resend AND RESEND_API_KEY to enable it; only the
# weekly-report summary is ever emailed, to the user's own address.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
